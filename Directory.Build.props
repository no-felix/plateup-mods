<Project>
  <Import Project="$(MSBuildThisFileDirectory)Local.Build.props" Condition="Exists('$(MSBuildThisFileDirectory)Local.Build.props')" />
  <PropertyGroup>
    <PlateUpDir Condition="'$(PlateUpDir)' == ''">$(MSBuildProgramFiles32)\Steam\steamapps\common\PlateUp\PlateUp</PlateUpDir>
    <GameManagedDir>$(PlateUpDir)\PlateUp_Data\Managed</GameManagedDir>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
